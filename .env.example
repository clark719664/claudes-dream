# Shared by both processes. Generate with: openssl rand -base64 32
# This authenticates the bot to the bridge. Devices never see it.
BRIDGE_SECRET=replace-me

# --- bridge ---------------------------------------------------------------
BRIDGE_PORT=8080
# How long a /link code stays valid.
BRIDGE_PAIRING_TTL_MS=300000
# Audio held before playback starts. Raise it if phones on mobile data stutter.
BRIDGE_PREBUFFER_MS=1500
# Hard cap on buffered audio; older frames are dropped beyond this.
BRIDGE_MAX_BUFFER_MS=10000
# Grace period before a disconnected device loses its session.
BRIDGE_SESSION_GRACE_MS=60000

# --- bot ------------------------------------------------------------------
# From https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=replace-me
# Same page, "Application ID"
DISCORD_CLIENT_ID=replace-me
# Optional. Set while developing: guild commands appear instantly,
# global commands can take up to an hour.
DISCORD_GUILD_ID=

# Where the bot reaches the bridge.
BRIDGE_URL=http://127.0.0.1:8080

LOG_LEVEL=info
