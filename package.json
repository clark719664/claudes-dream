{
  "name": "prism-break",
  "version": "0.1.0",
  "private": true,
  "description": "Prism Break - a one-thumb colour-chaining brick breaker with a collectible sticker album.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "tsx test/run.ts",
    "test:browser": "node test/smoke.mjs ./test/shots && node test/smoke-meta.mjs ./test/shots",
    "cap:sync": "npm run build && cap sync",
    "cap:add": "cap add android && cap add ios",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
